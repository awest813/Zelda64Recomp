@@ -74,7 +74,23 @@ namespace ultramodern {
 
             virtual ~GraphicsConfig() = default;
 
+#if defined(__GNUC__) && (__GNUC__ < 10)
+            bool operator==(const GraphicsConfig& rhs) const {
+                return developer_mode == rhs.developer_mode
+                    && res_option == rhs.res_option
+                    && wm_option == rhs.wm_option
+                    && hr_option == rhs.hr_option
+                    && api_option == rhs.api_option
+                    && ar_option == rhs.ar_option
+                    && msaa_option == rhs.msaa_option
+                    && rr_option == rhs.rr_option
+                    && hpfb_option == rhs.hpfb_option
+                    && rr_manual_value == rhs.rr_manual_value
+                    && ds_option == rhs.ds_option;
+            }
+#else
             auto operator<=>(const GraphicsConfig& rhs) const = default;
+#endif
         };
 
         const GraphicsConfig& get_graphics_config();
