 static std::vector<uint8_t> rom;
 
+#ifdef DREAMCAST
+static std::filesystem::path rom_stream_path;
+static size_t rom_stream_size = 0;
+static std::mutex rom_stream_mutex;
+static FILE* rom_stream_file = nullptr;
+
+static bool rom_stream_ensure_open() {
+    if (rom_stream_file != nullptr) {
+        return true;
+    }
+    rom_stream_file = fopen(rom_stream_path.c_str(), "rb");
+    return rom_stream_file != nullptr;
+}
+
+static void rom_stream_close() {
+    if (rom_stream_file != nullptr) {
+        fclose(rom_stream_file);
+        rom_stream_file = nullptr;
+    }
+}
+
+static bool rom_stream_read(uint32_t offset, void* dest, size_t count) {
+    if (offset + count > rom_stream_size) {
+        return false;
+    }
+    std::lock_guard lock{rom_stream_mutex};
+    if (!rom_stream_ensure_open()) {
+        return false;
+    }
+    if (fseek(rom_stream_file, static_cast<long>(offset), SEEK_SET) != 0) {
+        return false;
+    }
+    return fread(dest, 1, count, rom_stream_file) == count;
+}
+#endif
+
 bool recomp::is_rom_loaded() {
+#ifdef DREAMCAST
+    return !rom.empty() || rom_stream_size != 0;
+#else
     return !rom.empty();
+#endif
 }
 
 void recomp::set_rom_contents(std::vector<uint8_t>&& new_rom) {
     rom = std::move(new_rom);
+#ifdef DREAMCAST
+    rom_stream_path.clear();
+    rom_stream_size = 0;
+#endif
 }
 
+#ifdef DREAMCAST
+void recomp::set_rom_stream(const std::filesystem::path& path, size_t size) {
+    std::lock_guard lock{rom_stream_mutex};
+    rom.clear();
+    rom_stream_close();
+    rom_stream_path = path;
+    rom_stream_size = size;
+}
+#endif
+
 std::span<const uint8_t> recomp::get_rom() {
     return rom;
 }
