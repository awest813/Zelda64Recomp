@@ -66,6 +81,36 @@ static inline void DMULTU(uint64_t a, uint64_t b, uint64_t* lo64, uint64_t* hi64
     *lo64 = _umul128(a, b, hi64);
 }
 
+#elif defined(DREAMCAST)
+static inline void DMULTU(uint64_t a, uint64_t b, uint64_t* lo64, uint64_t* hi64) {
+    const uint64_t a_lo = a & 0xFFFFFFFFull;
+    const uint64_t a_hi = a >> 32;
+    const uint64_t b_lo = b & 0xFFFFFFFFull;
+    const uint64_t b_hi = b >> 32;
+    const uint64_t p0 = a_lo * b_lo;
+    const uint64_t p1 = a_lo * b_hi;
+    const uint64_t p2 = a_hi * b_lo;
+    const uint64_t p3 = a_hi * b_hi;
+    const uint64_t cy = (p0 >> 32) + (p1 & 0xFFFFFFFFull) + (p2 & 0xFFFFFFFFull);
+    *lo64 = p0 + ((cy & 0xFFFFFFFFull) << 32);
+    *hi64 = p3 + (p1 >> 32) + (p2 >> 32) + (cy >> 32);
+}
+
+static inline void DMULT(int64_t a, int64_t b, int64_t* lo64, int64_t* hi64) {
+    const int neg = (a < 0) ^ (b < 0);
+    uint64_t ua = (uint64_t)(a < 0 ? -a : a);
+    uint64_t ub = (uint64_t)(b < 0 ? -b : b);
+    uint64_t ulo = 0;
+    uint64_t uhi = 0;
+    DMULTU(ua, ub, &ulo, &uhi);
+    if (neg) {
+        ulo = ~ulo + 1;
+        uhi = ~uhi + (ulo == 0);
+    }
+    *lo64 = (int64_t)(ulo);
+    *hi64 = (int64_t)(uhi);
+}
+
 #else
 #error "128-bit integer type not found"
 #endif
